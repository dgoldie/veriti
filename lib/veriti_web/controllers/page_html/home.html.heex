<Layouts.flash_group flash={@flash} />

<%!-- Hero --%>
<div class="hero min-h-[60vh] bg-base-200">
  <div class="hero-content text-center max-w-2xl">
    <div>
      <h1 class="text-5xl font-bold tracking-tight">
        Verify Vehicle Titles with Confidence
      </h1>
      <p class="mt-6 text-lg text-base-content/70 leading-relaxed">
        Upload a photo or scan of any vehicle title and Veriti will extract
        the key fields, check the VIN, detect liens, and flag issues —
        in seconds.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <%= if @current_scope do %>
          <.link navigate={~p"/submissions/new"} class="btn btn-primary btn-lg">
            Submit a Title
          </.link>
          <.link navigate={~p"/submissions"} class="btn btn-outline btn-lg">
            My Submissions
          </.link>
        <% else %>
          <.link navigate={~p"/users/register"} class="btn btn-primary btn-lg">
            Get Started Free
          </.link>
          <.link navigate={~p"/users/log-in"} class="btn btn-outline btn-lg">
            Log In
          </.link>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%!-- How it works --%>
<div class="py-20 px-4">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold text-center mb-4">How It Works</h2>
    <p class="text-center text-base-content/60 mb-14">
      Three steps from upload to a clean validation report.
    </p>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div class="card bg-base-200">
        <div class="card-body items-center text-center">
          <div class="badge badge-primary badge-lg text-lg font-bold w-10 h-10 flex items-center justify-center mb-2">
            1
          </div>
          <h3 class="card-title">Upload</h3>
          <p class="text-base-content/70 text-sm">
            Drag and drop a JPG, PNG, or PDF scan of the vehicle title.
            We accept documents up to 10 MB.
          </p>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body items-center text-center">
          <div class="badge badge-primary badge-lg text-lg font-bold w-10 h-10 flex items-center justify-center mb-2">
            2
          </div>
          <h3 class="card-title">Extract</h3>
          <p class="text-base-content/70 text-sm">
            OCR reads the document and pulls VIN, title number, owner,
            odometer, lienholder, and state fields automatically.
          </p>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body items-center text-center">
          <div class="badge badge-primary badge-lg text-lg font-bold w-10 h-10 flex items-center justify-center mb-2">
            3
          </div>
          <h3 class="card-title">Validate</h3>
          <p class="text-base-content/70 text-sm">
            Each field is checked against state-specific rules. VIN checksums,
            lien detection, and format validation surface any issues instantly.
          </p>
        </div>
      </div>
    </div>

    <%= if is_nil(@current_scope) do %>
      <div class="text-center mt-14">
        <.link navigate={~p"/users/register"} class="btn btn-primary btn-lg">
          Create a Free Account
        </.link>
      </div>
    <% end %>
  </div>
</div>
