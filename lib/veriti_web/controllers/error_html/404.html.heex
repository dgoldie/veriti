<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <title>404 Not Found · Veriti</title>
  </head>
  <body class="bg-base-100 min-h-screen flex flex-col items-center justify-center text-center px-4">
    <p class="text-8xl font-black text-primary opacity-20 select-none">404</p>
    <h1 class="text-3xl font-bold -mt-4">Page not found</h1>
    <p class="mt-3 text-base-content/60 max-w-sm">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href={~p"/"} class="btn btn-primary mt-8">Go to Home</a>
  </body>
</html>
